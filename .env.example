PORT=5000
DATABASE_URL=mysql://user:password@localhost:3306/edutrust
JWT_SALT=your_jwt_secret_salt_key

# Google Gemini AI (for interview sessions)
GEMINI_API_KEY=your_gemini_api_key

# Cloudinary (Media assets)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Supports either KEYID / RAZOR_KEYSEC or RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET)
KEYID=rzp_test_placeholder
RAZOR_KEYSEC=dummy_secret
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=dummy_secret

# Nodemailer / Email OTP
MAIL_PASS=your_email_smtp_password
EMAIL_USER=mail@skillpass.org

# Client URL (for CORS)
FRONTEND_URL=https://skillpass-quizzes.vercel.app
